 "sub": {
  "L01": [
   "Palm Springs — новая Jebel Ali Village?"
  ],
  "L02": [
   "Nakheel готовит новое комьюнити в Jebel Ali."
  ],
  "L03": [
   "Вот что известно."
  ],
  "L04": [
   "Девелопер — Nakheel, часть Dubai Holding."
  ],
  "L05": [
   "Создатели Palm Jumeirah, а теперь —",
   "Palm Jebel Ali, вдвое больше."
  ],
  "L06": [
   "Пример — Jebel Ali Village."
  ],
  "L07": [
   "2021: виллы на 4 спальни —",
   "старт от AED 4,3 млн."
  ],
  "L08": [
   "Сейчас сделки — около AED 8,5 млн.",
   "Почти вдвое больше."
  ],
  "L09": [
   "Локация — Jebel Ali, рядом",
   "Palm Jebel Ali и Sheikh Zayed Road."
  ],
  "L10": [
   "Рядом фризона:",
   "более 160 000 рабочих мест."
  ],
  "L11": [
   "И аэропорт Al Maktoum за AED 128 млрд —",
   "будущий крупнейший в мире."
  ],
  "L12": [
   "Дома: таунхаусы на 3–4 спальни",
   "и виллы на 4–5 спален."
  ],
  "L13": [
   "По предварительным данным —",
   "от AED 3,8 до 9 млн."
  ],
  "L14": [
   "Теперь сравним."
  ],
  "L15": [
   "Готовые таунхаусы на 3 спальни",
   "в Jebel Ali Village — AED 4,5–5 млн."
  ],
  "L16": [
   "Это около AED 1 700 за кв. фут."
  ],
  "L17": [
   "Maple в Dubai Hills — почти до AED 5 млн."
  ],
  "L18": [
   "Arabian Ranches III — около AED 3 млн,",
   "но намного дальше."
  ],
  "L19": [
   "А на самом Palm Jebel Ali",
   "таунхаусы — от AED 14,9 млн."
  ],
  "L20": [
   "Поэтому ключевая цифра —",
   "за квадратный фут:"
  ],
  "L21": [
   "Ниже AED 1 700 — и вы покупаете новое",
   "дешевле готового по соседству."
  ],
  "L22": [
   "И дефицит работает на вас."
  ],
  "L23": [
   "Из почти 97 000 домов, которые",
   "сдадут в Дубае в этом году,",
   "вилл — лишь около 5 400."
  ],
  "L24": [
   "Планировки и план оплаты Nakheel",
   "пока не раскрыл. Приём заявок — в ноябре,",
   "хотя по сути он уже стартовал."
  ],
  "L25": [
   "Итог: девелопер и локация —",
   "сильные аргументы."
  ],
  "L26": [
   "Решать будет цена за квадратный фут."
  ],
  "L27": [
   "Рост капитала не гарантирован,",
   "но лучшие цены обычно — в первой фазе."
  ],
  "L27b": [
   "Решать вам."
  ],
  "L28": [
   "Подробности — сразу после старта продаж."
  ],
  "L29": [
   "Как обычно, будет уже поздно:",
   "лучшие юниты, да и всё комьюнити,",
   "продаются до старта продаж."
  ],
  "L30": [
   "Говорю вам по опыту."
  ]
 }
}